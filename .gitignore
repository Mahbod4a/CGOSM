# ═══════════════════════════════════════════════════════════════
#  AIS Global Tracker — Git Ignore
# ═══════════════════════════════════════════════════════════════

# ── Environment secrets (NEVER commit) ─────────────────────────
.env
.env.local
.env.*.local

# ── Data (runtime files) ───────────────────────────────────────
AIS_Data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ───────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── IDE / Editor ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── OS ─────────────────────────────────────────────────────────
Thumbs.db
desktop.ini

# ── Docker ─────────────────────────────────────────────────────
.dockerignore
docker-compose.override.yml
